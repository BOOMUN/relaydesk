AGENTDESK_APP_NAME=RelayDesk
AGENTDESK_ENVIRONMENT=local
AGENTDESK_HOST=0.0.0.0
AGENTDESK_PORT=8000
AGENTDESK_DATABASE_URL=sqlite:///./data/agentdesk.db
# PostgreSQL pool tuning (ignored for SQLite). Keep pool_size * worker_count
# below PostgreSQL max_connections and leave headroom for migrations/monitoring.
AGENTDESK_DATABASE_POOL_SIZE=10
AGENTDESK_DATABASE_MAX_OVERFLOW=10
AGENTDESK_DATABASE_POOL_TIMEOUT_SECONDS=30
AGENTDESK_DATABASE_POOL_RECYCLE_SECONDS=1800
AGENTDESK_DATABASE_POOL_PRE_PING=true
AGENTDESK_DATABASE_POOL_USE_LIFO=true
AGENTDESK_DATABASE_CONNECT_TIMEOUT_SECONDS=10
AGENTDESK_ADMIN_EMAIL=admin@local.test
AGENTDESK_ADMIN_PASSWORD=replace-with-a-strong-password
AGENTDESK_SESSION_HOURS=12
AGENTDESK_SEED_DEMO_DATA=true
AGENTDESK_MAX_AGENT_SEATS=5
AGENTDESK_DEFAULT_LOCALE=zh-TW

# Keep one AI conversation context active until the customer is silent for 30 minutes.
AGENTDESK_AI_CONTEXT_INACTIVITY_MINUTES=30
AGENTDESK_AI_CONTEXT_MAX_MESSAGES=40
AGENTDESK_AI_CONTEXT_MAX_CHARACTERS=12000
AGENTDESK_AI_CONTEXT_SCHEDULER_INTERVAL_SECONDS=15
AGENTDESK_AI_CONTEXT_CLOSE_RETRY_MINUTES=5

# Website knowledge sync runs once per day at 03:10 Beijing time.
AGENTDESK_KNOWLEDGE_QUEUE_MODE=redis
AGENTDESK_KNOWLEDGE_REDIS_URL=redis://127.0.0.1:6380/7
AGENTDESK_KNOWLEDGE_SYNC_TIMEZONE=Asia/Shanghai
AGENTDESK_KNOWLEDGE_SYNC_HOUR=3
AGENTDESK_KNOWLEDGE_SYNC_MINUTE=10

# OpenAI is optional. Without it the local deterministic demo agent is used.
AGENTDESK_OPENAI_API_KEY=
AGENTDESK_OPENAI_BASE_URL=
AGENTDESK_OPENAI_MODEL=
# Embedding storage/retrieval provider.  FastEmbed is multilingual and works
# without an API gateway; local_hash is only for isolated regression fixtures.
AGENTDESK_EMBEDDING_PROVIDER=fastembed
AGENTDESK_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AGENTDESK_EMBEDDING_DIMENSIONS=384
AGENTDESK_EMBEDDING_BATCH_SIZE=128
AGENTDESK_EMBEDDING_THREADS=4
AGENTDESK_EMBEDDING_WARMUP_ENABLED=true
AGENTDESK_EMBEDDING_REBUILD_ON_MISMATCH=true
# Optional OpenAI-compatible embedding model when provider=openai.
AGENTDESK_OPENAI_EMBEDDING_MODEL=
# Raw cosine threshold used to reject unrelated RAG matches.
AGENTDESK_RAG_MIN_SIMILARITY=0.15
# Final BM25/vector/metadata score required before a source may reach the model.
AGENTDESK_RAG_MIN_RETRIEVAL_SCORE=0.46
# Require meaningful query/source term coverage unless semantic confidence is very high.
AGENTDESK_RAG_MIN_LEXICAL_SCORE=0.03
AGENTDESK_RAG_SEMANTIC_OVERRIDE_SCORE=0.55
AGENTDESK_RAG_VECTOR_CANDIDATE_LIMIT=64
AGENTDESK_RAG_HNSW_EF_SEARCH=64
AGENTDESK_RAG_HNSW_ITERATIVE_SCAN=strict_order
AGENTDESK_RAG_LEXICAL_TERM_LIMIT=8

# Encrypts REST Action credentials before database storage. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTDESK_SECRETS_ENCRYPTION_KEY=

# Optional controlled web-search fallback. It is also disabled per Agent
# version until an administrator publishes a policy that enables it.
AGENTDESK_WEB_SEARCH_PROVIDER=disabled
AGENTDESK_WEB_SEARCH_API_KEY=
AGENTDESK_WEB_SEARCH_TIMEOUT_SECONDS=8
AGENTDESK_WEB_SEARCH_MAX_RESULTS=5

# WhatsApp provider: demo, evolution, or meta.
AGENTDESK_WHATSAPP_PROVIDER=demo

# Evolution API / WhatsApp Web. scripts/setup-evolution.ps1 generates these locally.
AGENTDESK_EVOLUTION_API_URL=http://127.0.0.1:8081
AGENTDESK_EVOLUTION_API_KEY=
AGENTDESK_EVOLUTION_INSTANCE_NAME=agentdesk
AGENTDESK_EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8000/api/webhooks/evolution
AGENTDESK_EVOLUTION_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API remains available as an alternative provider.
AGENTDESK_META_VERIFY_TOKEN=replace-with-a-random-token
AGENTDESK_META_APP_SECRET=
AGENTDESK_META_ACCESS_TOKEN=
AGENTDESK_META_PHONE_NUMBER_ID=
AGENTDESK_META_BUSINESS_ACCOUNT_ID=
AGENTDESK_META_GRAPH_VERSION=
